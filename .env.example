# ---------------------------------------------------------------------------
# Redline Employee Portal — environment configuration
# Copy this file to ".env" and fill in the values. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3000

# "development" locally, "production" when deployed behind HTTPS.
# In production this enables Secure session cookies.
NODE_ENV=development

# Long random string used to sign the session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Supabase ----  (Project Settings -> API in your Supabase dashboard)
# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# "anon" / public key. Used only to verify passwords at login time.
SUPABASE_ANON_KEY=

# "service_role" key. SECRET — full admin access to your database.
# Used by the backend for privileged actions (create users, approvals, queries).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- First admin (you) ----
# On startup the server creates this account if it doesn't exist yet, and marks
# it approved + admin. Change the password after your first login.
ADMIN_NAME=Redline Admin
ADMIN_EMAIL=admin@redline.com
ADMIN_PASSWORD=change-me-now
